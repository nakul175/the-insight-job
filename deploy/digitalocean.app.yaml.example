# DRAFT TEMPLATE — not deployable until placeholders, approvals and release gates are resolved.
# Reference: https://docs.digitalocean.com/products/app-platform/reference/app-spec/
name: the-insight-job-staging
region: REQUIRES_APPROVED_REGION
services:
  - name: web
    github:
      repo: nakul175/the-insight-job
      branch: main
      deploy_on_push: false
    dockerfile_path: Dockerfile
    source_dir: /
    http_port: 8080
    instance_count: 1
    instance_size_slug: REQUIRES_APPROVED_SIZE_AND_BUDGET
    health_check:
      http_path: /health/ready/
    envs:
      - key: DJANGO_DEBUG
        value: "false"
        scope: RUN_TIME
      - key: DJANGO_SECRET_KEY
        type: SECRET
        scope: RUN_TIME
        value: REQUIRES_SECRET_IN_DIGITALOCEAN
      - key: DATABASE_URL
        type: SECRET
        scope: RUN_TIME
        value: REQUIRES_APPROVED_POSTGRES_CONNECTION_WITH_TLS
      - key: DJANGO_ALLOWED_HOSTS
        value: REQUIRES_APPROVED_HOST
        scope: RUN_TIME
      - key: CSRF_TRUSTED_ORIGINS
        value: https://REQUIRES_APPROVED_HOST
        scope: RUN_TIME
      - key: TRUST_PROXY_HTTPS
        value: "true"
        scope: RUN_TIME
