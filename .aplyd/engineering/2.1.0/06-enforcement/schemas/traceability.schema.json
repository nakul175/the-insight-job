{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "APLYD engineering traceability ledger",
  "type": "object",
  "properties": {
    "schema_version": {
      "enum": [
        2
      ]
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "implementation",
              "engineering",
              "discovery"
            ]
          },
          "authorization_ref": {
            "type": "string",
            "minLength": 1
          },
          "requirement_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "design_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "status": {
            "enum": [
              "planned",
              "implemented",
              "reviewed",
              "merged",
              "deployed",
              "blocked"
            ]
          },
          "branch": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "commit": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "pr": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "review_ref": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "release": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "deployment_evidence": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "notes": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "task_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/#-]{0,199}$"
          },
          "tracker_ref": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "legacy_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "story_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "acceptance_criterion_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "qa_case_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "qa_run_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "qa_case_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "version"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          }
        },
        "required": [
          "kind",
          "authorization_ref",
          "requirement_refs",
          "design_refs",
          "rationale",
          "paths",
          "status",
          "branch",
          "commit",
          "pr",
          "review_ref",
          "release",
          "deployment_evidence",
          "notes",
          "task_id",
          "tracker_ref",
          "legacy_ids",
          "story_ids",
          "acceptance_criterion_ids",
          "qa_case_ids",
          "qa_run_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "records"
  ],
  "additionalProperties": false
}
